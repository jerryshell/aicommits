{
  "name": "@jerryshell/aicommits",
  "version": "0.1.6",
  "description": "AI-powered git commit message generator",
  "license": "MIT",
  "contributors": [
    "Hassan El Mghari (@nutlope)",
    "Jerry (@jerryshell)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryshell/aicommits.git"
  },
  "bin": {
    "aic": "dist/cli.mjs",
    "aicommits": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outfile=dist/cli.mjs --format=esm --minify --target=node",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc",
    "test": "bun run build && bun test tests/",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.67",
    "@ai-sdk/openai-compatible": "^3.0.49",
    "@ai-sdk/provider": "^4",
    "@clack/prompts": "^0.11.0",
    "@types/bun": "^1.4.2",
    "@types/ini": "^1.3.34",
    "ai": "^7.0.102",
    "cleye": "^2.6.0",
    "execa": "^7.2.0",
    "fs-fixture": "^1.2.0",
    "ini": "^3.0.1",
    "kolorist": "^1.8.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
